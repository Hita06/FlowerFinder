# Flutter / Dart cache files
# These are generated by Flutter and Dart. They should not be uploaded.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# Build output
# Flutter creates this folder when building or running the app.
build/

# Android generated files
# These are local Android build/cache files.
android/.gradle/
android/local.properties
android/app/build/
android/build/

# Android signing files
# These files may contain private keys for publishing the app.
*.keystore
*.jks

# iOS generated files
# These are generated by CocoaPods, Xcode, or Flutter.
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/build/

# iOS signing files
# These files may contain Apple certificates or provisioning profiles.
*.p8
*.p12
*.mobileprovision

# Environment variables and API keys
# Put private keys, API tokens, and local config in .env files.
.env
.env.*
!.env.example

# Editor and IDE files
# These are personal settings from VS Code, Android Studio, or IntelliJ.
.vscode/
.idea/
*.iml

# System files
# macOS and Windows create these automatically.
.DS_Store
Thumbs.db

# Logs
# Log files are generated while developing or debugging.
*.log
